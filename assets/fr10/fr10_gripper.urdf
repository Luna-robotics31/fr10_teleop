<?xml version="1.0" encoding="utf-8"?>
<!--
  FAIRINO FR10 (fairino10_v6) with a generic parallel-jaw gripper.

  Arm links, joints, limits and inertials are copied unchanged from the official
  fairino_description/urdf/fairino10_v6.urdf (frcobot_ros2). Additions:
    * flange              - tool mounting face, 0.106 m along the j6 axis (DH d6)
    * gripper_base_link   - gripper body, fixed to the flange (turned 90 deg about the tool axis)
    * finger_left/right   - prismatic fingers, joint value = half opening [0 .. 0.05 m]
  Grasp centre (TCP) = flange + (0, 0, 0.130); it is defined in config/default.yaml, not here.
  Mesh paths are relative to this file.
-->
<robot name="fr10_gripper">
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00037778 -0.00035367 0.035825" rpy="0 0 0" />
      <mass value="0.73775" />
      <inertia ixx="0.0026263" ixy="1.1085E-05" ixz="-8.5601E-06" iyy="0.0026258" iyz="-7.9868E-06" izz="0.0044466" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.STL" />
      </geometry>
      <material name="base_link_color">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.0001 -0.02612 0.00404" rpy="0 0 0" />
      <mass value="11.97" />
      <inertia ixx="0.04607471" ixy="-0.00001041" ixz="-0.00009371" iyy="0.03493881" iyz="0.00133107" izz="0.04467851" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/shoulder_link.STL" />
      </geometry>
      <material name="shoulder_link_color">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/shoulder_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="j1" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="shoulder_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.0543" upper="3.0543" effort="150" velocity="3.15" />
    <dynamics damping="0" friction="0" />
  </joint>
  <link name="upperarm_link">
    <inertial>
      <origin xyz="0.48027 0.00001 0.16468" rpy="0 0 0" />
      <mass value="19.59" />
      <inertia ixx="0.0649166" ixy="0.00054242" ixz="-0.02821532" iyy="1.81964752" iyz="-0.00005779" izz="1.80524518" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upperarm_link.STL" />
      </geometry>
      <material name="upperarm_link_color">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upperarm_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="j2" type="revolute">
    <origin xyz="0 0 0.18" rpy="1.5708 0 0" />
    <parent link="shoulder_link" />
    <child link="upperarm_link" />
    <axis xyz="0 0 1" />
    <limit lower="-4.6251" upper="1.4835" effort="150" velocity="3.15" />
    <dynamics damping="0" friction="0" />
  </joint>
  <link name="forearm_link">
    <inertial>
      <origin xyz="0.21122 0.00011 0.05421" rpy="0 0 0" />
      <mass value="3.7" />
      <inertia ixx="0.00642901" ixy="0.00004731" ixz="0.00070041" iyy="0.20273064" iyz="0.00000774" izz="0.20206759" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/forearm_link.STL" />
      </geometry>
      <material name="forearm_link_color">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/forearm_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="j3" type="revolute">
    <origin xyz="-0.7 0 0" rpy="0 0 0" />
    <parent link="upperarm_link" />
    <child link="forearm_link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.8274" upper="2.8274" effort="150" velocity="3.15" />
    <dynamics damping="0" friction="0" />
  </joint>
  <link name="wrist1_link">
    <inertial>
      <origin xyz="0.00012 -0.003 0.01218" rpy="0 0 0" />
      <mass value="1.69" />
      <inertia ixx="0.00248058" ixy="0.00001495" ixz="0.00002165" iyy="0.00239729" iyz="-0.00007228" izz="0.00180628" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist1_link.STL" />
      </geometry>
      <material name="wrist1_link_color">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist1_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="j4" type="revolute">
    <origin xyz="-0.586 0 0" rpy="0 0 0" />
    <parent link="forearm_link" />
    <child link="wrist1_link" />
    <axis xyz="0 0 1" />
    <limit lower="-4.6251" upper="1.4835" effort="28" velocity="3.2" />
    <dynamics damping="0" friction="0" />
  </joint>
  <link name="wrist2_link">
    <inertial>
      <origin xyz="-0.00012 0.003 0.01218" rpy="0 0 0" />
      <mass value="1.69" />
      <inertia ixx="0.00248058" ixy="0.00001495" ixz="-0.00002165" iyy="0.00239729" iyz="0.00007228" izz="0.00180628" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist2_link.STL" />
      </geometry>
      <material name="wrist2_link_color">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist2_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="j5" type="revolute">
    <origin xyz="0 0 0.159" rpy="1.5708 0 0" />
    <parent link="wrist1_link" />
    <child link="wrist2_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2" />
    <dynamics damping="0" friction="0" />
  </joint>
  <link name="wrist3_link">
    <inertial>
      <origin xyz="0.00124 0.00085 -0.02034" rpy="0 0 0" />
      <mass value="0.35" />
      <inertia ixx="0.00023661" ixy="-0.00000085" ixz="0.00000092" iyy="0.00023501" iyz="-0.00000154" izz="0.00036972" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist3_link.STL" />
      </geometry>
      <material name="wrist3_link_color">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist3_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="j6" type="revolute">
    <origin xyz="0 0 0.114" rpy="-1.5708 0 0" />
    <parent link="wrist2_link" />
    <child link="wrist3_link" />
    <axis xyz="0 0 1" />
    <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2" />
    <dynamics damping="0" friction="0" />
  </joint>
  <!-- ===== tool flange: mounting face, d6 = 0.106 m along the j6 axis (z points out of the flange) ===== -->
  <link name="flange" />
  <joint name="wrist3_to_flange" type="fixed">
    <origin xyz="0 0 0.106" rpy="0 0 0" />
    <parent link="wrist3_link" />
    <child link="flange" />
  </joint>
  <!-- ===== parallel-jaw gripper (primitive geometry). It is mounted turned 90 deg about the tool axis: the fingers open along +/- y of gripper_base_link = -/+ x of the flange ===== -->
  <link name="gripper_base_link">
    <inertial>
      <origin xyz="0 0 0.041" rpy="0 0 0" />
      <mass value="0.7" />
      <inertia ixx="0.00153557" ixy="0" ixz="0" iyy="0.00063117" iyz="0" izz="0.00138227" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.040" length="0.012" />
      </geometry>
      <material name="gripper_dark">
        <color rgba="0.15 0.15 0.17 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.040" length="0.012" />
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.047" rpy="0 0 0" />
      <geometry>
        <box size="0.064 0.140 0.070" />
      </geometry>
      <material name="gripper_dark">
        <color rgba="0.15 0.15 0.17 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.047" rpy="0 0 0" />
      <geometry>
        <box size="0.064 0.140 0.070" />
      </geometry>
    </collision>
  </link>
  <joint name="flange_to_gripper" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 1.5707963267948966" />
    <parent link="flange" />
    <child link="gripper_base_link" />
  </joint>
  <link name="finger_left_link">
    <inertial>
      <origin xyz="0 0.008 0.033" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="0.00002276" ixy="0" ixz="0" iyy="0.00002516" iyz="0" izz="0.00000436" />
    </inertial>
    <visual>
      <origin xyz="0 0.008 0.033" rpy="0 0 0" />
      <geometry>
        <box size="0.026 0.014 0.066" />
      </geometry>
      <material name="finger_pad">
        <color rgba="0.05 0.05 0.05 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.008 0.033" rpy="0 0 0" />
      <geometry>
        <box size="0.026 0.014 0.066" />
      </geometry>
    </collision>
  </link>
  <joint name="finger_left_joint" type="prismatic">
    <origin xyz="0 0 0.082" rpy="0 0 0" />
    <parent link="gripper_base_link" />
    <child link="finger_left_link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.05" effort="100" velocity="0.2" />
    <dynamics damping="0" friction="0" />
  </joint>
  <link name="finger_right_link">
    <inertial>
      <origin xyz="0 -0.008 0.033" rpy="0 0 0" />
      <mass value="0.06" />
      <inertia ixx="0.00002276" ixy="0" ixz="0" iyy="0.00002516" iyz="0" izz="0.00000436" />
    </inertial>
    <visual>
      <origin xyz="0 -0.008 0.033" rpy="0 0 0" />
      <geometry>
        <box size="0.026 0.014 0.066" />
      </geometry>
      <material name="finger_pad">
        <color rgba="0.05 0.05 0.05 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.008 0.033" rpy="0 0 0" />
      <geometry>
        <box size="0.026 0.014 0.066" />
      </geometry>
    </collision>
  </link>
  <joint name="finger_right_joint" type="prismatic">
    <origin xyz="0 0 0.082" rpy="0 0 0" />
    <parent link="gripper_base_link" />
    <child link="finger_right_link" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.05" effort="100" velocity="0.2" />
    <dynamics damping="0" friction="0" />
  </joint>
</robot>
